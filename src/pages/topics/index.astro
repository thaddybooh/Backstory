---
import Base from '../../layouts/Base.astro';
import TopicCard from '../../components/topicmap/TopicCard.astro';
import { getTopicSummaries } from '../../lib/topicmap-data';
import { getIssues } from '../../lib/issues';

const [latest] = await getIssues();
const topics = await getTopicSummaries(latest?.id);
// Grouped by track so the page stays easy to scan as maps are added.
const groups = [
  { track: 'world', title: 'World' },
  { track: 'singapore', title: 'Singapore' },
]
  .map((g) => ({ ...g, topics: topics.filter((t) => t.map.data.track === g.track) }))
  .filter((g) => g.topics.length > 0);
---

<Base title="Topics" description="Big subjects mapped out as questions: how things work, what is changing, and why. Each grows as new issues are published.">
  <div class="wrap">
    <header class="page-head">
      <h1>Topics</h1>
      <p>
        One big subject in the middle, the background you need around it, and the changes in the news, each opened up
        into the questions a curious reader would ask. Every answer comes with its sources, and each topic grows as new
        issues are published.
      </p>
    </header>
    {
      groups.map((g) => (
        <section class="topic-group" data-track={g.track} aria-labelledby={`topics-${g.track}`}>
          <h2 id={`topics-${g.track}`}>
            {g.title} <span>{g.topics.length} {g.topics.length === 1 ? 'topic' : 'topics'}</span>
          </h2>
          <div class="topic-cards">
            {g.topics.map((t) => (
              <TopicCard topic={t} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
