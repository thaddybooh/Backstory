---
// The homepage band under today's issue: every topic map, so readers can follow the
// bigger story that each day's issue is part of. The cards leave out their question
// counts and photo credits here; the homepage lists the credits at the bottom.
import TopicCard from './TopicCard.astro';
import { getTopicSummaries } from '../../lib/topicmap-data';

interface Props {
  /** Today's issue, so its topic comes first and is marked. */
  issueId?: string;
}
const topics = await getTopicSummaries(Astro.props.issueId);
---

{
  topics.length > 0 && (
    <section class="topics-band" aria-labelledby="topics-band-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="topics-band-title">Follow the bigger story</h2>
          <a href="/topics/">All topics</a>
        </div>
        <div class="topic-cards">
          {topics.map((t) => (
            <TopicCard topic={t} compact />
          ))}
        </div>
      </div>
    </section>
  )
}
