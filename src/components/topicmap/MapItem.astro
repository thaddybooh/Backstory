---
// One box of a topic map in its list view, with everything under it nested beneath.
// topicmap.ts reads these elements (their data- attributes) to draw the tree.
import type { MapCategory, MapNode } from '../../lib/topicmap-data';
import { QUESTION_TYPE, CATEGORY_KIND } from '../../lib/topicmap-data';

interface Props {
  node: MapCategory | MapNode;
  category: MapCategory;
  parent?: string;
  depth: number;
}
const { node, category, parent, depth } = Astro.props;
const type = 'type' in node ? node.type : undefined;
const when = 'when' in node ? node.when : undefined;
const tag = type
  ? QUESTION_TYPE[type]
  : depth === 1
    ? CATEGORY_KIND[category.kind]
    : category.kind === 'news'
      ? `In the news${when ? ` · ${when}` : ''}`
      : 'Topic';
const related = 'related' in node ? node.related : [];
---

<li>
  <details
    data-node={node.id}
    data-label={node.label}
    data-parent={parent}
    data-category={category.kind}
    data-depth={depth}
    data-type={type}
    data-when={when}
    data-issue={'issue' in node ? node.issue : undefined}
    data-related={related.length ? related.join(' ') : undefined}
  >
    <summary>
      <span class="tmap-tag" data-type={type} data-category={category.kind}>{tag}</span>
      <span class="tmap-q">{node.question}</span>
    </summary>
    <div class="qa">
      {node.answer.map((p) => <p>{p}</p>)}
      <p class="qa-label">Sources to dig deeper</p>
      <ul class="qa-sources">
        {
          node.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">
                {s.title}
              </a>
              <span>{s.publication}</span>
            </li>
          ))
        }
      </ul>
      {
        'issue' in node && node.issue && (
          <a class="qa-read" href={`/issues/${node.issue}/`}>
            Read the full But Why? issue <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </details>
  {
    node.children.length > 0 && (
      <ol class="qmap-follow tmap-sub">
        {node.children.map((c) => (
          <Astro.self node={c} category={category} parent={node.id} depth={depth + 1} />
        ))}
      </ol>
    )
  }
</li>
