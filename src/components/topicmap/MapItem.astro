---
// One question in a topic map's list view, with its own questions nested beneath it.
// topicmap.ts reads these elements (their data- attributes) to draw the graph.
import type { MapBranch, MapNode } from '../../lib/topicmap-data';
import { QUESTION_TYPE } from '../../lib/topicmap-data';

interface Props {
  node: MapBranch | MapNode;
  branch: MapBranch;
  parent?: string;
  depth: number;
}
const { node, branch, parent, depth } = Astro.props;
const type = 'type' in node ? node.type : undefined;
const kicker = type ? QUESTION_TYPE[type] : branch.kind === 'news' ? `In the news${branch.when ? ` · ${branch.when}` : ''}` : 'Background';
---

<li>
  <details
    data-node={node.id}
    data-label={node.label}
    data-parent={parent}
    data-branch={branch.id}
    data-kind={branch.kind}
    data-depth={depth}
    data-type={type}
    data-when={depth === 1 ? branch.when : undefined}
    data-related={'related' in node && node.related.length ? node.related.join(' ') : undefined}
  >
    <summary>
      <span class="tmap-tag" data-type={type ?? branch.kind}>{kicker}</span>
      {node.question}
    </summary>
    <div class="qa">
      {node.answer.map((p) => <p>{p}</p>)}
      <p class="qa-label">Sources to dig deeper</p>
      <ul class="qa-sources">
        {
          node.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">
                {s.title}
              </a>
              <span>{s.publication}</span>
            </li>
          ))
        }
      </ul>
      {
        'issue' in node && node.issue && (
          <a class="qa-read" href={`/issues/${node.issue}/`}>
            Read the full But Why? issue <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </details>
  {
    node.children.length > 0 && (
      <ol class="qmap-follow tmap-sub">
        {node.children.map((c) => (
          <Astro.self node={c} branch={branch} parent={node.id} depth={depth + 1} />
        ))}
      </ol>
    )
  }
</li>
